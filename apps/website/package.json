{
  "name": "callerwhale-landing-site",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5200 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 5200 --strictPort",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@callerwhale/auth-client": "1.0.0",
    "@callerwhale/calendar": "1.0.0",
    "@callerwhale/error-report": "1.0.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  }
}
