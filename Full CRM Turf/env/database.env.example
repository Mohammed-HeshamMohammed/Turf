# The Turf database in production (Coolify project "turf-database"). Paste the line each app needs into that app's
# environment. __DB_HOST__ is the database's name inside Coolify's network; env-init fills it from TURF_DB_HOST.
CORE_API_DATABASE_URL=postgres://turf_api:__DB_API_PASSWORD__@__DB_HOST__:5432/turf
CORE_API_MIGRATION_DATABASE_URL=postgres://turf_owner:__DB_OWNER_PASSWORD__@__DB_HOST__:5432/turf
AUTH_DATABASE_URL=postgres://turf_auth:__DB_AUTH_PASSWORD__@__DB_HOST__:5432/turf_auth
