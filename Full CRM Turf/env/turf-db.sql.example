-- Run in turf-postgres as postgres. Creates the core API roles and database.
-- Never use the "postgres" superuser from an app: it would bypass row security.
CREATE ROLE turf_owner LOGIN PASSWORD '__DB_OWNER_PASSWORD__' CREATEROLE;
CREATE ROLE turf_app NOLOGIN NOBYPASSRLS;
CREATE ROLE turf_api LOGIN PASSWORD '__DB_API_PASSWORD__' NOBYPASSRLS IN ROLE turf_app;
GRANT turf_app TO turf_owner WITH ADMIN OPTION;
CREATE DATABASE turf OWNER turf_owner;

\connect turf
CREATE EXTENSION IF NOT EXISTS pgcrypto;
CREATE EXTENSION IF NOT EXISTS citext;
GRANT CONNECT ON DATABASE turf TO turf_app;
