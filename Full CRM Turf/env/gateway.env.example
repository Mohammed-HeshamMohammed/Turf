# The gateway (services/gateway): the one public entry point. Settings only; it keeps no secrets.

PORT=8100

# host=upstream, comma separated. The upstreams are private addresses (Coolify: the applications' network aliases).
ROUTES=app.callerwhale.com=http://core-api:8088,grafana.callerwhale.com=http://grafana-proxy:8120
# The host whose upstream is the core API: its paths are checked (tokens, staff, private routes).
CORE_HOST=app.callerwhale.com
# Tokens must be Firebase ID tokens of this project (the same value as the core API's TURF_FIREBASE_PROJECT).
FIREBASE_PROJECT_ID=project-34ff1df6-b240-40d4-be2

# Staff paths (/api/v1/platform/*) need the authenticator step. Switch off only while staff have none set up.
STAFF_REQUIRE_SECOND_FACTOR=true
# Requests a minute per address and per signed-in person.
IP_PER_MINUTE=600
USER_PER_MINUTE=1800
MAX_BODY_MB=64
# Proxies in front of the gateway (Coolify's Traefik: 1). Wrong here, and callers could pick their own address.
PROXY_HOPS=1
