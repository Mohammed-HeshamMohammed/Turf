# The core API (services/core-api/scripts/run-api.sh). Create core-api.env with: node tools/env-init.mjs
DATABASE_URL=postgres://turf_api:turf_api@127.0.0.1:55432/turf
MIGRATION_DATABASE_URL=postgres://turf_owner:turf_owner@127.0.0.1:55432/turf
REDIS_URL=redis://127.0.0.1:56379
TURF_BIND=127.0.0.1:8088
TURF_ALLOWED_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
# Secret. Workers present one of these (name=token); env-init generates it and puts the same token in worker.env.
TURF_WORKER_TOKENS=dev=__WORKER_TOKEN__
# Secret. The payment provider signs its webhooks with it (24 characters or more; shorter turns webhooks off).
TURF_BILLING_WEBHOOK_SECRET=__SECRET__
# Where checkout sends the browser. Empty: no hosted checkout.
TURF_CHECKOUT_URL=
# The auth service, while sign-in is still there.
TURF_AUTH_JWKS_URL=http://localhost:8101/.well-known/jwks.json
TURF_AUTH_PUBLIC_URL=http://localhost:8101
# New accounts may open their own trial (false: by invitation only).
TURF_PUBLIC_SIGNUP=false
TURF_REQUIRE_MFA=false
# Firebase (docs/plans/firebase-auth.md). An empty project: Firebase is not used. These values are public by design.
TURF_FIREBASE_PROJECT=
TURF_FIREBASE_API_KEY=
TURF_FIREBASE_APP_ID=
TURF_FIREBASE_AUTH_DOMAIN=
TURF_FIREBASE_PROVIDERS=google
# The Grafana login proxy (services/grafana-proxy), where the admin dashboard sends staff. Empty: no Grafana.
TURF_GRAFANA_URL=
# Turf's staff confirm an authenticator code to open the admin pages. false only while the Firebase project has no
# authenticator codes (Identity Platform TOTP) turned on.
TURF_STAFF_MFA=true
# Desktop access by invitation (docs/plans/callerwhale-launch.md). The website people are invited to.
TURF_WEBSITE_URL=http://localhost:5200
# The mail server invitations go out through (Mail-Server: STARTTLS on 587). Empty host: invitations are saved, not emailed.
TURF_SMTP_HOST=
TURF_SMTP_PORT=587
TURF_SMTP_USER=no-reply@softfix.dev
# Secret. The mailbox's password.
TURF_SMTP_PASSWORD=
TURF_MAIL_FROM=Turf <no-reply@softfix.dev>
# The GitHub repository whose releases hold the desktop installer, offered to invited people only. Empty: no download.
TURF_RELEASE_REPO=Mohammed-HeshamMohammed/Turf
TURF_RELEASE_TAG_PREFIX=crm-v
# Secret, optional. A token that can read the releases, for a private repository.
TURF_GITHUB_TOKEN=
