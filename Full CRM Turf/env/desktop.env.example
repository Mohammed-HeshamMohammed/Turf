# The desktop app and the CRM in a browser (desktop/frontend/react; read when it is built or served).
# Everything here ends up inside the app, so nothing here is a server secret.
VITE_TURF_API_URL=http://localhost:8088
VITE_TURF_AUTH_URL=http://localhost:8101
# Firebase web app (docs/plans/firebase-auth.md). An empty API key: sign in with the auth service.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROVIDERS=google
# Google sign-in in the desktop app: the "Desktop app" OAuth client. Google ships its secret inside installed apps.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
