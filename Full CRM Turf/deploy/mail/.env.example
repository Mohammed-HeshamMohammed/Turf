# Settings for deploy/mail/compose.yml. In Coolify, set these in the resource's Environment Variables instead
# (Coolify lists them from the compose file). Locally: copy to deploy/mail/.env, which git ignores.
# The server's name: what it says when it says hello. Its DNS A record, and the reverse DNS of the VPS, must be this.
MAIL_HOSTNAME=smtp.softfix.dev
POSTMASTER_ADDRESS=postmaster@softfix.dev
# Let's Encrypt writes here when the certificate is about to expire.
LETSENCRYPT_EMAIL=softfix.dev@gmail.com
# Secret. A Cloudflare API token (My Profile > API Tokens > Create Token > "Edit zone DNS") for the zone softfix.dev only.
CLOUDFLARE_API_TOKEN=__SECRET__
# Secrets. The mailboxes apps log in with. Made once at the first start; an empty password skips that mailbox.
# no-reply@softfix.dev: Turf and softfix-backend.  no-reply@auto-linky.com: auto-linky.
PASSWORD_SOFTFIX_NOREPLY=__SECRET__
PASSWORD_AUTOLINKY_NOREPLY=__SECRET__
# Optional: your own mailbox for Thunderbird (for example you@softfix.dev). Its domain must be softfix.dev or auto-linky.com.
MAILBOX_ME=
PASSWORD_ME=
