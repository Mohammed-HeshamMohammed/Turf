# The upload service on Coolify (application "Importing Lists", image cw-importing-lists, port 8111, network alias importing-lists, NO domain).
# It takes list uploads in, in checked pieces, and keeps them in its own volume until the importing worker (importing-worker) fetches them.
# Paste into Environment Variables -> Developer View. Fill every <...>. Secrets stay in Coolify; never commit a filled copy.
# HTTP port; default 8111. Match Coolify's container port; the gateway sends uploads to http://importing-lists:8111.
PORT=8111
# Secret PostgreSQL URI with the importer's own login: the importing schema and a view of a few lead fields, nothing else.
DATABASE_URL=<postgres://importer:password@crm-postgres:5432/crm?sslmode=require>
# Where uploads wait until the worker fetches them; default /data/imports. This application's own persistent volume, not shared.
IMPORT_DIR=/data/imports
# Secret, 32+ characters: the same value as importing-worker's. The worker fetches uploads with it. Empty turns the worker's fetching off.
IMPORT_FILE_TOKEN=<the same 32+ character secret as importing-worker>
# Internal CRM Core origin for validating the bearer token, workspace and import permission, and creating a source list.
CORE_URL=http://crm-core:8107
# Maximum accepted list size in MiB; default 20480.
MAX_IMPORT_MB=20480
# Days an upload's files may stay here at most; default 30, the same as the worker's.
# IMPORT_KEEP_FILE_DAYS=30
