/**
 * Caller Whale's rules for who may do what (services/authz). The authorization service writes this schema to SpiceDB when it
 * starts. Object ids: user and platform ids are plain; role, team and project ids are "<workspace id>/<key or id>", so one
 * workspace's objects can be listed and removed by prefix.
 */

definition user {}

/** Caller Whale's own staff. One object: platform:callerwhale. */
definition platform {
    relation owner: user
    relation admin: user

    permission staff = owner + admin
    permission manage_staff = owner
    permission is_owner = owner
    permission is_admin = admin
}

/**
 * A role in one workspace: one of the presets (owner, solo, manager, caller, closer, researcher, client) or one the workspace
 * made. Each grants_* relation holds user:* when the role grants that capability; scope_* says which records its holders see.
 */
definition role {
    relation member: user

    relation grants_edit: user:*
    relation grants_assign: user:*
    relation grants_handoff: user:*
    relation grants_accept: user:*
    relation grants_call: user:*
    relation grants_message: user:*
    relation grants_export: user:*
    relation grants_finance: user:*
    relation grants_import: user:*
    relation grants_rules: user:*
    relation grants_admin: user:*
    relation grants_review: user:*
    relation grants_public_comment: user:*

    relation scope_organization: user:*
    relation scope_team: user:*
    relation scope_project: user:*
    relation scope_own: user:*
    relation scope_shared: user:*

    relation second_step: user:*
    relation manages_access: user:*

    permission holder = member

    permission can_edit = member & grants_edit
    permission can_assign = member & grants_assign
    permission can_handoff = member & grants_handoff
    permission can_accept = member & grants_accept
    permission can_call = member & grants_call
    permission can_message = member & grants_message
    permission can_export = member & grants_export
    permission can_finance = member & grants_finance
    permission can_import = member & grants_import
    permission can_rules = member & grants_rules
    permission can_admin = member & grants_admin
    permission can_review = member & grants_review
    permission can_public_comment = member & grants_public_comment

    permission sees_organization = member & scope_organization
    permission sees_team = member & scope_team
    permission sees_project = member & scope_project
    permission sees_own = member & scope_own
    permission sees_shared = member & scope_shared

    permission needs_second_step = member & second_step
    permission can_manage_access = member & manages_access
}

/**
 * A workspace. without_* takes one capability or scope away from one person (a restriction); suspended and payment_required
 * hold user:* while the workspace is suspended or its plan needs paying (set by billing and by staff).
 */
definition organization {
    relation platform: platform
    relation role: role

    relation suspended: user:*
    relation payment_required: user:*

    relation without_edit: user
    relation without_assign: user
    relation without_handoff: user
    relation without_accept: user
    relation without_call: user
    relation without_message: user
    relation without_export: user
    relation without_finance: user
    relation without_import: user
    relation without_rules: user
    relation without_admin: user
    relation without_review: user
    relation without_public_comment: user

    relation without_scope_organization: user
    relation without_scope_team: user
    relation without_scope_project: user
    relation without_scope_own: user
    relation without_scope_shared: user

    permission member = role->holder

    permission cap_edit = role->can_edit - without_edit
    permission cap_assign = role->can_assign - without_assign
    permission cap_handoff = role->can_handoff - without_handoff
    permission cap_accept = role->can_accept - without_accept
    permission cap_call = role->can_call - without_call
    permission cap_message = role->can_message - without_message
    permission cap_export = role->can_export - without_export
    permission cap_finance = role->can_finance - without_finance
    permission cap_import = role->can_import - without_import
    permission cap_rules = role->can_rules - without_rules
    permission cap_admin = role->can_admin - without_admin
    permission cap_review = role->can_review - without_review
    permission cap_public_comment = role->can_public_comment - without_public_comment

    permission scope_organization = role->sees_organization - without_scope_organization
    permission scope_team = role->sees_team - without_scope_team
    permission scope_project = role->sees_project - without_scope_project
    permission scope_own = role->sees_own - without_scope_own
    permission scope_shared = role->sees_shared - without_scope_shared

    permission second_step = role->needs_second_step
    permission manage_access = role->can_manage_access + platform->staff
    permission is_suspended = suspended
    permission needs_payment = payment_required
}

/** A team in a workspace. Id: "<workspace id>/<team id>". */
definition team {
    relation organization: organization
    relation member: user

    permission belongs = member
}

/** A project in a workspace. Id: "<workspace id>/<project id>". */
definition project {
    relation organization: organization
    relation member: user

    permission belongs = member
}
