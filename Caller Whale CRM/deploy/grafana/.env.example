# Settings for deploy/grafana/compose.yml. In Coolify, set these in the resource's Environment Variables instead
# (Coolify lists them from the compose file). Locally: copy to deploy/grafana/.env, which git ignores.
# Auth service URL used to validate sessions, MFA, and current platform role. The proxy fails closed when Auth is unavailable.
CALLERWHALE_AUTH_URL=https://auth.callerwhale.com
# The website with Dashboard admin mode: the only site allowed to post a sign-in.
# Trusted website origin allowed to frame Grafana and post the session handoff. Must match the website hosting Dashboard admin mode.
CALLERWHALE_WEBSITE_URL=https://callerwhale.com
# Browser subpath; neither monitoring container gets a domain. The landing website uses VITE_CALLERWHALE_GATEWAY_URL.
# Browser root URL including the protected /staff/monitoring/ subpath. Compose maps it to GF_SERVER_ROOT_URL; never a direct public Grafana domain.
GRAFANA_PUBLIC_URL=https://gate.callerwhale.com/staff/monitoring/
# Secret. Grafana's own "admin" account. Nobody can sign in with it; set so Grafana doesn't keep its default password.
# Secret initial Grafana admin password, replacing the image default. Login form/basic auth remain disabled; changing env alone may not reset an existing stored admin password.
GRAFANA_ADMIN_PASSWORD=__SECRET__
# Grafana role for system administrators: Viewer, Editor or Admin; default Editor. Platform owner and cofounder remain Admin. Raising it grants more dashboard permissions.
ADMIN_GRAFANA_ROLE=Editor
# Plugins to install, comma separated (e.g. grafana-clock-panel).
# Comma-separated Grafana plugin IDs to preinstall. Adding third-party plugins changes the dashboard code loaded at startup; review plugins before installing.
GRAFANA_PLUGINS=
# Maximum interval between staff authorization rechecks; default 60s. Shorter intervals increase API traffic; revocation is checked on subsequent requests.
RECHECK_EVERY=60s
# Absolute proxy session lifetime; default 1h. Expiry requires a new authorized sign-in even while the user remains active.
SESSION_MAX_AGE=1h
# Inactivity limit for proxy sessions; default 10m. Idle sessions require fresh entry; this does not keep a disconnected browser authorized indefinitely.
IDLE_TIMEOUT=10m
# Maximum age of the authentication used to enter monitoring; default 15m. Old sign-ins cannot create a fresh proxy session.
AUTH_WITHIN=15m
# false only for local http.
# Secure session-cookie flag; default true. Keep true with HTTPS in production; false is only for local HTTP testing.
COOKIE_SECURE=true
