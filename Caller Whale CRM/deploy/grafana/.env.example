# Settings for deploy/grafana/compose.yml. In Coolify, set these in the resource's Environment Variables instead
# (Coolify lists them from the compose file). Locally: copy to deploy/grafana/.env, which git ignores.
# The core API, which says who is staff (GET /api/v1/platform/whoami).
CALLERWHALE_CORE_API_URL=https://app.callerwhale.com
# The website with Dashboard admin mode: the only site allowed to post a sign-in.
CALLERWHALE_WEBSITE_URL=https://callerwhale.com
# Browser subpath; neither monitoring container gets a domain. Set CALLERWHALE_GRAFANA_URL to this (without trailing slash) on core-api and GRAFANA_ORIGIN=https://app.callerwhale.com on landing-web.
GRAFANA_PUBLIC_URL=https://app.callerwhale.com/staff/monitoring/
# Secret. Grafana's own "admin" account. Nobody can sign in with it; set so Grafana doesn't keep its default password.
GRAFANA_ADMIN_PASSWORD=__SECRET__
# Grafana role for system administrators: Viewer, Editor or Admin. The platform owner is always Admin.
ADMIN_GRAFANA_ROLE=Editor
# Plugins to install, comma separated (e.g. grafana-clock-panel).
GRAFANA_PLUGINS=
RECHECK_EVERY=60s
SESSION_MAX_AGE=1h
IDLE_TIMEOUT=10m
AUTH_WITHIN=15m
# false only for local http.
COOKIE_SECURE=true
