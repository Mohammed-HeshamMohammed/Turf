# The live server on Coolify (application "centrifugo", Docker image centrifugo/centrifugo:v6, port 8000, network alias centrifugo, NO domain of its own).
# It holds the apps' sockets and delivers what the messaging service tells it; the gateway routes live.callerwhale.com to it. Setup: docs/plans/coolify-setup-messaging.md.
# Paste into Environment Variables -> Developer View. Fill every <...>. Secrets stay in Coolify; never commit a filled copy.
# Secret: 64 random hex characters. Only the messaging service calls the API, with this key (its LIVE_API_KEY).
CENTRIFUGO_HTTP_API_KEY=<the live server's API key>
# Secret: 64 random hex characters, different from the key above. Connection tokens are signed with it (messaging's LIVE_TOKEN_SECRET).
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=<the live server's token secret>
# Pages that may open a socket.
CENTRIFUGO_CLIENT_ALLOWED_ORIGINS=https://app.callerwhale.com
# Each person listens on a channel only they may subscribe to: chat:user#<their id>.
# Turns on the /health address that Coolify's healthcheck calls (Healthcheck tab: GET http://localhost:8000/health, expect 200).
CENTRIFUGO_HEALTH_ENABLED=true
# Each person listens on a channel only they may subscribe to: chat:user#<their id>.
CENTRIFUGO_CHANNEL_NAMESPACES=[{"name":"chat","allow_user_limited_channels":true}]
