# The core API on Coolify (application "core-api", port 8088, domain https://appapi.callerwhale.com; the site and the apps reach it through the gateway at https://gate.callerwhale.com).
# Paste into Environment Variables -> Developer View. Fill every <...>.
DATABASE_URL=<postgres://callerwhale_api:password@host:5432/callerwhale>
DATABASE_SETUP_URL=<postgres://callerwhale_owner:password@host:5432/callerwhale>
REDIS_URL=
CALLERWHALE_BIND=0.0.0.0:8088
CALLERWHALE_WORKER_TOKENS=<name=token, 24+ characters; the worker uses the same token>
CALLERWHALE_BILLING_WEBHOOK_SECRET=<24+ characters>
CALLERWHALE_CHECKOUT_URL=
CALLERWHALE_ALLOWED_ORIGINS=https://callerwhale.com,https://gate.callerwhale.com,tauri://localhost,http://tauri.localhost
CALLERWHALE_PUBLIC_SIGNUP=false
CALLERWHALE_REQUIRE_MFA=false
CALLERWHALE_STAFF_MFA=true
CALLERWHALE_WEBSITE_URL=https://callerwhale.com
# Sign-in is the auth service only: this server checks its tokens with its public keys. No Firebase settings here.
CALLERWHALE_AUTH_JWKS_URL=https://auth.callerwhale.com/.well-known/jwks.json
CALLERWHALE_AUTH_PUBLIC_URL=https://auth.callerwhale.com
CALLERWHALE_GRAFANA_URL=https://gate.callerwhale.com/staff/monitoring
# Invitations are emailed by the notification service, which holds the mail login.
CALLERWHALE_NOTIFY_URL=https://notify.callerwhale.com
CALLERWHALE_NOTIFY_TOKEN=<the core-api token from NOTIFY_TOKENS>
CALLERWHALE_RELEASE_REPO=Mohammed-HeshamMohammed/Turf
CALLERWHALE_RELEASE_TAG_PREFIX=crm-v
