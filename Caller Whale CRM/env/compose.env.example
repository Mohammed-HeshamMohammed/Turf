# Every service on one machine (deploy/compose.yml): docker compose --env-file env/compose.env -f deploy/compose.yml up
# Secret. The database's password; env-init generates it.
POSTGRES_PASSWORD=__SECRET__
# Secret. Signs every access token; env-init generates one.
AUTH_SIGNING_KEY=__SIGNING_KEY__
# Secret. Signs the authorization service's grants; env-init generates one.
AUTHZ_SIGNING_KEY=__SIGNING_KEY__
# Secret. Billing's token at the authorization service (AUTHZ_TOKENS there, AUTHZ_TOKEN in billing).
AUTHZ_BILLING_TOKEN=__SECRET__
