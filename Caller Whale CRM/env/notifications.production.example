# The notification service on Coolify (application "notifications", port 8102). No domain and no gateway route: only auth calls it, at http://notifications:8102 on the private network, with its NOTIFY_TOKENS token.
# Paste into Environment Variables -> Developer View. Fill every <...>. This is the only place the mail server login lives: the
# auth service and the core API ask this service to send an email and never hold a mail setting themselves.
# Notification API HTTP listening port; default 8102. Match Coolify's private/public upstream configuration.
PORT=8102
# Who may ask for mail: name=token pairs, comma separated, each token at least 24 random characters (the caller sets the same
# token: AUTH_NOTIFY_TOKEN on auth, CALLERWHALE_NOTIFY_TOKEN on core-api).
# Secret caller=token pairs, 24+ characters each; only auth today. Match the caller's token; changing one side breaks that caller's mail.
NOTIFY_TOKENS=auth=<24+ random characters>
# The mail server (the Mail-Server project): STARTTLS on 587 or TLS on 465, never in the clear.
# SMTP server hostname for delivery. Use the mail server's authenticated submission endpoint, not an inbound MX routing worker.
NOTIFY_SMTP_HOST=<mail server>
# SMTP submission port; default 587. Use STARTTLS 587 or implicit TLS 465 as supported by the server; do not use cleartext submission.
NOTIFY_SMTP_PORT=587
# SMTP mailbox login; not a forwarding alias unless the mail server explicitly supports alias authentication. Must match the allowed sender.
NOTIFY_SMTP_USER=<mailbox login>
# Secret SMTP mailbox password. Rotate together with the mail server credential; incorrect value breaks every notification email.
NOTIFY_SMTP_PASSWORD=<mailbox password>
# The mail server lets a login send only as its own address, so this is the mailbox's address with the display name Caller Whale.
# Email From header with Caller Whale display name and permitted sender mailbox. Must match mail-server sender authorization, not merely a forwarding destination.
NOTIFY_MAIL_FROM=Caller Whale <the mailbox address>
