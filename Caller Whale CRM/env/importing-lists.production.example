# The import worker on Coolify (application "importing-lists", branch importing-lists-backend-production, port 8111, network alias importing-lists, NO domain).
# It loads uploaded lists into the CRM database, drops identical rows, matches columns, cleans phones, emails and addresses and finds repeats. It is idle until a list is queued.
# Do NOT set a memory or CPU limit on this application: a large list may use what the server has.
# Paste into Environment Variables -> Developer View. Fill every <...>. Secrets stay in Coolify; never commit a filled copy.
# HTTP port for the health check; default 8111.
PORT=8111
# Secret PostgreSQL URI with the worker's own login (importer): the importing schema and a view of a few lead fields, nothing else.
DATABASE_URL=<postgres://importer:password@crm-postgres:5432/crm?sslmode=require>
# The worker's own persistent upload volume; default /data/imports. Do not mount it in crm-core.
IMPORT_DIR=/data/imports
# Internal CRM Core origin for validating the bearer token, workspace and import permission, and creating a source list.
CORE_URL=http://crm-core:8107
# Maximum accepted list size in MiB; default 20480.
MAX_IMPORT_MB=20480
# Memory one sort or hash in the repeat-finding steps may use before spilling to disk; default 256MB. Raise it on a big server for faster very large lists.
# IMPORT_WORK_MEM=256MB
# Connections one import uses at the same time to tidy its rows; default 4 or the number of CPUs if fewer. 1 runs one after another.
# IMPORT_PARALLEL=4
