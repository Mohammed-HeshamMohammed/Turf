# The gateway on Coolify (application "gateway", port 8100). Domains: gate.callerwhale.com (for now the notification service, so the only thing answering there is the website's contact form at /api/v1/public/contact; the core API takes it back when it is rebuilt), auth.callerwhale.com (the auth service, so the human check sees every sign-in). Everything else of the notification service stays private (/v1/* is never passed on). Paste into Developer View. The reCAPTCHA secret key is the only secret here: enter it privately in Coolify, never in GitHub.
# Gateway HTTP listen port; default 8100. Match Coolify's upstream container port.
PORT=8100
# Comma-separated public-host=http(s)://private-upstream mappings. Changing this changes traffic destinations; do not expose internal-only services as public routes.
ROUTES=gate.callerwhale.com=http://notifications:8102,auth.callerwhale.com=http://auth:8101,mcp.callerwhale.com=http://mcp:8106
# Hostname in ROUTES that receives core-API access policy and private monitoring routing. Must match a configured route exactly.
CORE_HOST=gate.callerwhale.com
# Trusted auth public-key endpoint for token verification. Required when CORE_HOST is set; wrong keys block protected access.
AUTH_JWKS_URL=http://auth:8101/.well-known/jwks.json
# Staff-route second-factor requirement; defaults on unless false. Keep true in production to protect admin/monitoring access.
STAFF_REQUIRE_SECOND_FACTOR=true
# Positive per-IP requests-per-minute limit; default 600. Too low blocks legitimate shared-network users; too high weakens throttling.
IP_PER_MINUTE=600
# Positive per-authenticated-user requests-per-minute limit; default 1800. Changing it affects API throttling for signed-in users.
USER_PER_MINUTE=1800
# Positive maximum accepted request body size in MiB; default 64. Smaller limits can reject uploads; larger limits increase memory/traffic exposure.
MAX_BODY_MB=64
# Trusted proxy-hop count for resolving the client IP; default 1. Match the actual proxy chain or IP rate limits can identify clients incorrectly.
PROXY_HOPS=1

# Only CORE_HOST /staff/monitoring/ reaches this private proxy.
# Private Grafana proxy HTTP origin, without path/query. Reached only through CORE_HOST /staff/monitoring; never give Grafana a direct public route.
MONITORING_UPSTREAM=http://grafana-proxy:8120

# ---- The human check (Google reCAPTCHA) in front of auth ----
# This is the only place it is checked: auth has no check of its own, no public domain of its own, and be reached only through this gateway.
# true turns it on and then needs every value below, or the gateway will not start. Leave false until the keys exist.
# true turns on the reCAPTCHA check in front of auth sign-up, sign-in, provider start and the website's waitlist and contact forms; needs every RECAPTCHA_* value and AUTH_HOST or the gateway will not start.
HUMAN_CHECK=false
# The ROUTES host that is the auth service. Must be one of the ROUTES hosts. Set it even while HUMAN_CHECK is false (see Hiding what exists below).
# The ROUTES host that is the auth service. Only its real routes are answered; everything else is a plain Not found. Must be one of the ROUTES hosts.
AUTH_HOST=auth.callerwhale.com
# checkbox: the visible "I'm not a robot" box (reCAPTCHA v2 keys); score: invisible (v3 keys); default score. Keys of the other kind are refused.
RECAPTCHA_KIND=checkbox
# The reCAPTCHA key's ID (public; the sign-in pages receive it from auth's /v1/security answer through this gateway). Starts with 6L.
# Public reCAPTCHA key ID, of the kind RECAPTCHA_KIND names (starts with 6L). The sign-in pages receive it from auth's /v1/security answer through the gateway.
RECAPTCHA_SITE_KEY=<key ID, or empty while the check is off>
# The key's legacy secret key (Google Cloud: open the key, Integrate with a third party service or plugin). Secret: Coolify only.
# Secret legacy reCAPTCHA key for the same key ID. Coolify only; never in GitHub, build variables or chat. Missing it with HUMAN_CHECK true prevents startup.
RECAPTCHA_SECRET_KEY=<legacy secret key, or empty while the check is off>
# Public v2 checkbox key ID (starts with 6L), a different key from RECAPTCHA_SITE_KEY. With RECAPTCHA_KIND=score it shows the box to people the invisible check cannot vouch for. Set with the secret.
RECAPTCHA_FALLBACK_SITE_KEY=
# Secret v2 checkbox key matching RECAPTCHA_FALLBACK_SITE_KEY; enter it only in Coolify. Set both fallback keys or neither.
RECAPTCHA_FALLBACK_SECRET_KEY=
# Sites a token may come from, comma separated, as Google reports them. Must match the key's domains (not tauri.localhost: the desktop app signs in through the browser).
# Comma-separated sites a token may come from, as Google reports them; must match the key's domains. A wrong list refuses real people.
RECAPTCHA_HOSTNAMES=callerwhale.com,auth.callerwhale.com
# Lowest Google score (0 bot to 1 human) accepted. 0.5 is Google's default; raise it if bots get through, lower it if real people are refused.
# Lowest Google score (0 bot to 1 human) accepted; default 0.5. Raise it if bots get through, lower it if real people are refused. Score kind only.
RECAPTCHA_MIN_SCORE=0.5
# Guarded requests (sign-up, sign-in, provider start) a minute from one address, counted before Google is asked.
# Guarded requests (sign-up, sign-in, provider start) a minute from one address, counted before Google is asked; default 30.
HUMAN_PER_MINUTE=30

# ---- Hiding what exists ----
# On the AUTH_HOST only the auth service's real routes are answered; everything else (and a real path with the wrong method) is the same plain
# "Not found", so a scan learns nothing. Set AUTH_HOST even while the human check is off.
# The gateway's own /healthz and /version, and the core API's, answer only inside the private network (the container's own health check), never through the public proxy.
# An address that asks for more than SCAN_LIMIT things that are not there within SCAN_WINDOW_MINUTES is paused for SCAN_PAUSE_MINUTES (people using the pages never ask for them).
# Requests for things that do not exist, from one address within SCAN_WINDOW_MINUTES, before that address is paused; default 20.
SCAN_LIMIT=20
# Minutes over which SCAN_LIMIT is counted; default 10.
SCAN_WINDOW_MINUTES=10
# Minutes an address stays paused after passing SCAN_LIMIT; default 15.
SCAN_PAUSE_MINUTES=15
# Sites allowed to read the gateway's own refusals (not a person, too many requests) in a browser: comma-separated origins like https://callerwhale.com. Empty: the browser shows a CORS error instead.
CORS_ORIGINS=https://callerwhale.com,https://app.callerwhale.com

# ---- AI assistants (the MCP service) ----
# The ROUTES host that is the MCP service (AI assistants connect to it). Only its few routes are answered; everything else is Not found. Must be one of the ROUTES hosts.
MCP_HOST=mcp.callerwhale.com
# Requests a minute from one address on the MCP host; default 6000. Higher than for people since assistants share a few addresses; each connection also has its own limit.
MCP_IP_PER_MINUTE=6000
