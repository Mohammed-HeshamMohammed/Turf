# The gateway on Coolify (application "gateway", port 8100). Domain: gate.callerwhale.com (the only one). Paste into Developer View. No secrets.
PORT=8100
ROUTES=gate.callerwhale.com=http://core-api:8088
CORE_HOST=gate.callerwhale.com
AUTH_JWKS_URL=http://auth:8101/.well-known/jwks.json
STAFF_REQUIRE_SECOND_FACTOR=true
IP_PER_MINUTE=600
USER_PER_MINUTE=1800
MAX_BODY_MB=64
PROXY_HOPS=1

# Only CORE_HOST /staff/monitoring/ reaches this private proxy.
MONITORING_UPSTREAM=http://grafana-proxy:8120
