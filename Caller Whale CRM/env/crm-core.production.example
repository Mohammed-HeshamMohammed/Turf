# The CRM's backend on Coolify (application "crm-core", branch crm-core-backend-production, port 8107, network alias crm-core, NO domain of its own).
# It keeps CRM records and syncs them to the web and desktop apps; the import worker receives uploaded lists.
# To switch the website over, after this and the import worker are healthy: in the gateway's ROUTES replace gate.callerwhale.com=http://notifications:8102 with gate.callerwhale.com=http://crm-core:8107 (the contact form keeps working: crm-core passes it to NOTIFY_URL).
# Paste into Environment Variables -> Developer View. Fill every <...>. Secrets stay in Coolify; never commit a filled copy.
# HTTP port; default 8107. Match Coolify's container port and the gateway's ROUTES.
PORT=8107
# Secret PostgreSQL URI of the CRM database with crm-core's login. The service creates its own tables (schemas crm and importing) at start.
DATABASE_URL=<postgres://crm_core:password@crm-postgres:5432/crm?sslmode=require>
# The auth service's public keys at its private address (http://auth:8101/.well-known/jwks.json); sign-in tokens are checked with them locally.
AUTH_JWKS_URL=http://auth:8101/.well-known/jwks.json
# The authorization service's private address, like http://authz:8104.
AUTHZ_URL=http://authz:8104
# Secret crm-core token: the value after core-api= in authz's AUTHZ_TOKENS, 32+ characters.
AUTHZ_TOKEN=<the core-api token from authz's AUTHZ_TOKENS>
# The notification service's private address; the website's contact form is passed on to it. Empty turns the form off.
NOTIFY_URL=http://notifications:8102
# Pages that may call crm-core from a browser, comma-separated origins like https://app.callerwhale.com. Keep it the same as the gateway's CORS_ORIGINS: the gateway passes a browser's preflight on and leaves the answer to this service.
CORS_ORIGINS=https://app.callerwhale.com,https://callerwhale.com
# Create the worker's login once in the CRM PostgreSQL (CREATE ROLE importer LOGIN PASSWORD '<long random password>';); crm-core grants it its tables at each start.
# The import worker's database login, given the holding tables at start. Empty until the worker is deployed.
IMPORT_DB_ROLE=importer
# The learning store's private address, like http://learning:8112. Empty turns the learning copy off: no list leaves crm-core.
LEARNING_URL=
# The learning store's LEARNING_TOKEN (at least 32 characters). Needed when LEARNING_URL is set.
LEARNING_TOKEN=
# Secret: the dialer service's CRM_TOKEN, 32+ characters. Turns on /internal/v1/dialer (private) so carrier calls are logged. Empty turns it off.
DIALER_TOKEN=

# The in-app assistant (build step 26): the assistant service and its AGENT_TOKEN (secret, Coolify only). Empty: the assistant is off.
ASSISTANT_URL=http://assistant:8109
ASSISTANT_TOKEN=<the same value as the assistant's AGENT_TOKEN>
# Charging the assistant's use (step 26): billing's private address and the crm-core token from its BILLING_TOKENS. Empty: not limited.
BILLING_URL=http://billing:8103
BILLING_TOKEN=<the crm-core token from billing's BILLING_TOKENS>

# Google Calendar (build step 28): a Google Cloud OAuth client (web application) with the Calendar API on, asking only for
# calendar.freebusy and calendar.app.created. GOOGLE_REDIRECT_URL is this service's callback as the public address serves it.
# GOOGLE_TOKEN_KEY: 32 random bytes in base64 (for example: openssl rand -base64 32); it encrypts the stored Google tokens.
# Secrets, set in Coolify only. Empty GOOGLE_CLIENT_ID: Google Calendar is off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.callerwhale.com/api/v1/google/callback
GOOGLE_TOKEN_KEY=
# The CRM web app: the link in calendar events, and where people return after connecting Google.
APP_URL=https://app.callerwhale.com

# Email to leads (build step 29) through Amazon SES. Its login: an IAM user allowed ses:SendRawEmail, ses:SendEmail,
# ses:CreateEmailIdentity and ses:GetEmailIdentity, out of the SES sandbox. Secrets, set in Coolify only.
# Replies: EMAIL_REPLY_DOMAIN's MX points at SES receiving in that region; a receipt rule sends its mail to an SNS topic (encoding
# Base64), and that topic has an HTTPS subscription to EMAIL_PUBLIC_URL/api/v1/public/email/inbound. Empty region: email is off.
EMAIL_SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_PUBLIC_URL=https://api.callerwhale.com
EMAIL_REPLY_DOMAIN=reply.callerwhale.com
EMAIL_SNS_TOPIC_ARN=

# Scheduled report emails (build step 32): the notification service and crm-core's token in its NOTIFY_TOKENS ("crm-core=<token>").
# Secret, set in Coolify only. Empty: reports are not sent. APP_URL (above) is the link in them.
NOTIFY_MAIL_URL=http://notifications:8102
NOTIFY_MAIL_TOKEN=<the crm-core token from notifications' NOTIFY_TOKENS>
