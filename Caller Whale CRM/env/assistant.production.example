# The website assistant on Coolify (application "assistant", branch assistant-backend-production, port 8109, network alias assistant, NO domain of its own).
# To publish it, add assistant.callerwhale.com=http://assistant:8109 to the gateway's ROUTES (and the same origins to the gateway's CORS_ORIGINS), then redeploy the gateway.
# Paste into Environment Variables -> Developer View. Secrets stay in Coolify; never commit a filled copy.
# HTTP port; default 8109. Match Coolify's container port and the gateway's ROUTES.
PORT=8109
# Pages that may call the assistant from a browser, comma-separated origins like https://callerwhale.com. Keep it the same as the gateway's CORS_ORIGINS.
CORS_ORIGINS=https://callerwhale.com
# The website's address (https, no trailing slash); the only web address an AI reply may keep. Default https://callerwhale.com.
SITE_URL=https://callerwhale.com
# Secret OpenRouter key. Empty runs the assistant from its script only.
OPENROUTER_API_KEY=<your OpenRouter key>
# The OpenRouter model name, like openai/gpt-4o-mini. A cheap, fast model is enough.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Messages one visitor may send a minute; default 12.
ASSISTANT_MESSAGES_PER_MINUTE=12
# AI answers one visitor may get a day; default 30. After that they get the script.
ASSISTANT_AI_PER_VISITOR_PER_DAY=30
# AI answers for all visitors together a day; default 2000. The ceiling on the bill.
ASSISTANT_AI_PER_DAY=2000

# The in-app assistant for the agency's people (build step 26): the key crm-core and dialer-sms use for /v1/agent/complete, 32+ characters.
# Secret, set in Coolify only. Empty: the in-app assistant is off (the website's helper chat still works).
AGENT_TOKEN=
