-- Run in callerwhale-postgres as postgres. Creates the core API roles and database.
-- Never use the "postgres" superuser from an app: it would bypass row security.
CREATE ROLE callerwhale_owner LOGIN PASSWORD '__DB_OWNER_PASSWORD__' CREATEROLE;
CREATE ROLE callerwhale_app NOLOGIN NOBYPASSRLS;
CREATE ROLE callerwhale_api LOGIN PASSWORD '__DB_API_PASSWORD__' NOBYPASSRLS IN ROLE callerwhale_app;
GRANT callerwhale_app TO callerwhale_owner WITH ADMIN OPTION;
CREATE DATABASE callerwhale OWNER callerwhale_owner;

\connect callerwhale
CREATE EXTENSION IF NOT EXISTS pgcrypto;
CREATE EXTENSION IF NOT EXISTS citext;
GRANT CONNECT ON DATABASE callerwhale TO callerwhale_app;
