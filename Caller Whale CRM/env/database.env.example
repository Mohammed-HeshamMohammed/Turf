# Caller Whale > database has separate private PostgreSQL resources for the core API and Auth.
# Paste each line into the matching application. Set CALLERWHALE_CORE_DB_HOST and CALLERWHALE_AUTH_DB_HOST
# to the two Coolify database container names before running env-init.mjs.
CORE_API_DATABASE_URL=postgres://callerwhale_api:__DB_API_PASSWORD__@__CORE_DB_HOST__:5432/callerwhale
CORE_API_MIGRATION_DATABASE_URL=postgres://callerwhale_owner:__DB_OWNER_PASSWORD__@__CORE_DB_HOST__:5432/callerwhale
AUTH_DATABASE_URL=postgres://callerwhale_auth:__DB_AUTH_PASSWORD__@__AUTH_DB_HOST__:5432/callerwhale_auth
