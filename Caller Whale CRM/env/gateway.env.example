# The gateway (services/gateway): the one public entry point. Settings only; it keeps no secrets.

PORT=8100

# host=upstream, comma separated. The upstreams are private addresses (Coolify: the applications' network aliases).
ROUTES=gate.callerwhale.com=http://core-api:8088,auth.callerwhale.com=http://auth:8101
# The host whose upstream is the core API: its paths are checked (tokens, staff, private routes).
CORE_HOST=gate.callerwhale.com
# Tokens are the auth service's: its public keys. The gateway knows nothing else about sign-in.
AUTH_JWKS_URL=http://auth:8101/.well-known/jwks.json

# Staff paths (/api/v1/platform/*) need the authenticator step. Switch off only while staff have none set up.
STAFF_REQUIRE_SECOND_FACTOR=true
# Requests a minute per address and per signed-in person.
IP_PER_MINUTE=600
USER_PER_MINUTE=1800
MAX_BODY_MB=64
# Proxies in front of the gateway (Coolify's Traefik: 1). Wrong here, and callers could pick their own address.
PROXY_HOPS=1

# Only CORE_HOST /staff/monitoring/ reaches this private proxy.
MONITORING_UPSTREAM=http://grafana-proxy:8120

# The human check (Google reCAPTCHA) for the auth service's first leg: sign-up, sign-in and provider starts.
# This is the only place it is checked: auth does not check it. Tokens work once, so two checks could not both pass.
# Turn it on only with real keys; true needs all four settings below or the gateway will not start.
# Create the key in Google Cloud (reCAPTCHA, Create key): type Web, domains callerwhale.com and auth.callerwhale.com, Challenge, Test
# key and WAF off. The site key is the key's ID. The secret is its legacy secret key (Integrate with a third party service or
# plugin): keep it in Coolify only, never in GitHub, a build variable or chat. Do not add tauri.localhost.
HUMAN_CHECK=false
# The ROUTES host that is the auth service. Used even while HUMAN_CHECK is false (see Hiding what exists below).
AUTH_HOST=auth.callerwhale.com
# Which Google check: checkbox shows the "I'm not a robot" box (reCAPTCHA v2 keys), score is invisible (v3 keys); default score.
# The keys below must be of the same kind, or every check is refused (the log says so).
RECAPTCHA_KIND=checkbox
RECAPTCHA_SITE_KEY=<key ID, or empty while the check is off>
RECAPTCHA_SECRET_KEY=<legacy secret key, or empty while the check is off>
# The sites a token may come from, comma separated, as Google reports them. Must match the key's domains.
RECAPTCHA_HOSTNAMES=callerwhale.com,auth.callerwhale.com
# Lowest Google score (0 bot to 1 human) accepted. 0.5 is Google's default.
RECAPTCHA_MIN_SCORE=0.5
# Guarded requests a minute from one address, counted before Google is asked (each one costs a call to Google).
HUMAN_PER_MINUTE=30

# ---- Hiding what exists ----
# On the AUTH_HOST only the auth service's real routes are answered; everything else (and a real path with the wrong method) is the same plain
# "Not found", so a scan learns nothing. Set AUTH_HOST even while the human check is off.
# The gateway's own /healthz and /version, and the core API's, answer only inside the private network (the container's own health check), never through the public proxy.
# An address that asks for more than SCAN_LIMIT things that are not there within SCAN_WINDOW_MINUTES is paused for SCAN_PAUSE_MINUTES (people using the pages never ask for them).
SCAN_LIMIT=20
SCAN_WINDOW_MINUTES=10
SCAN_PAUSE_MINUTES=15
