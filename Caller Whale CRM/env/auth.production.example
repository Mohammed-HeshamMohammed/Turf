# The auth service on Coolify (application "auth", port 8101, domain https://auth.callerwhale.com).
# Paste into Environment Variables -> Developer View. Fill every <...>; the rest is as it should be.
PORT=8101
# A PostgreSQL login for the auth service's own database.
DATABASE_URL=<postgres://user:password@host:5432/callerwhale_auth>
# Secret. Any 32 random bytes in base64 work, from any PC. In PowerShell:
#   $b = New-Object byte[] 32; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b) | Set-Clipboard
# (or `callerwhale-auth new-key`). Changing it signs everyone out.
AUTH_SIGNING_KEY=<base64 of 32 random bytes>
AUTH_PUBLIC_URL=https://auth.callerwhale.com
AUTH_WEBSITE_URL=https://gate.callerwhale.com
AUTH_APP_URL=https://gate.callerwhale.com
AUTH_LANDING_URL=https://callerwhale.com
AUTH_PUBLIC_SIGNUP=false
AUTH_DEV_TOKENS=false
AUTH_ALLOWED_ORIGINS=https://gate.callerwhale.com,https://callerwhale.com,tauri://localhost,http://tauri.localhost
# Firebase: only this service uses it (docs/plans/firebase-auth.md). Firebase console -> Project settings -> General -> Web API key.
AUTH_FIREBASE_API_KEY=<Web API key>
# Google sign-in: the Web client Firebase made (Google Cloud -> Credentials). Redirect URI: https://auth.callerwhale.com/v1/oauth/google/callback
AUTH_GOOGLE_CLIENT_ID=<client id>
AUTH_GOOGLE_CLIENT_SECRET=<client secret>
# Second step (docs/plans/second-factor.md). Email codes: the mail server (Mail-Server project). Telegram: optional, leave empty to
# not offer it. Authenticator apps and approvals on another device need nothing.
AUTH_SMTP_HOST=smtp.softfix.dev
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=<the same mailbox login as the core API's CALLERWHALE_SMTP_USER>
AUTH_SMTP_PASSWORD=<mailbox password>
# The mail server lets a login send only as its own address, so this is the mailbox's address with the display name Caller Whale.
AUTH_MAIL_FROM=Caller Whale <the mailbox address>
AUTH_TELEGRAM_BOT_TOKEN=<BotFather token, or empty>
AUTH_TELEGRAM_BOT_NAME=<@bot_name, or empty>
AUTH_TELEGRAM_WEBHOOK_SECRET=<a long random string, or empty>
