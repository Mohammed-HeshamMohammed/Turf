# The auth service on Coolify (application "auth", port 8101, domain https://auth.callerwhale.com).
# Paste into Environment Variables -> Developer View. Fill every <...>; the rest is as it should be.
# Runtime HTTP listening port; default 8101. Match Coolify's container port and private auth URLs when changing it.
PORT=8101
# A PostgreSQL login for the auth service's own database.
# Secret connection URI for auth's own database and sessions. Use its dedicated PostgreSQL login; changing the target changes the account/session store.
DATABASE_URL=<postgres://callerwhale_auth:password@host:5432/callerwhale_auth>
# Secret. Any 32 random bytes in base64 work, from any PC. In PowerShell:
#   $b = New-Object byte[] 32; (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b); [Convert]::ToBase64String($b) | Set-Clipboard
# (or `callerwhale-auth new-key`). Changing it signs everyone out.
# Secret Ed25519 signing key (base64 seed or PKCS#8). Keep stable; replacing it invalidates previously signed access tokens. Never put it in frontend settings.
AUTH_SIGNING_KEY=<base64 of 32 random bytes>
# Public auth base URL used for provider callbacks. Changing it requires matching Google/Apple callback registrations.
AUTH_PUBLIC_URL=https://auth.callerwhale.com
# Return base URL for the legacy website sign-in target. Must be a trusted application origin; changing it changes where that OAuth handoff returns.
AUTH_WEBSITE_URL=https://gate.callerwhale.com
# Return base URL for browser CRM sign-in. Does not replace the desktop app's restricted loopback return.
AUTH_APP_URL=https://gate.callerwhale.com
# Public site's sign-in return base URL. Keep it aligned with the deployed landing website.
AUTH_LANDING_URL=https://callerwhale.com
# true allows public account creation; false closes public registration. Separate from core-api's trial-workspace policy; keep false for invitation-only access.
AUTH_PUBLIC_SIGNUP=false
# Development-only confirmation tokens in API responses. Keep false in production; true exposes tokens intended only for local testing.
AUTH_DEV_TOKENS=false
# Comma-separated browser origins allowed to call auth. Include intended web and Tauri origins only; expanding this broadens cross-origin access.
AUTH_ALLOWED_ORIGINS=https://gate.callerwhale.com,https://callerwhale.com,tauri://localhost,http://tauri.localhost
# Firebase: only this service uses it (docs/plans/firebase-auth.md). Firebase console -> Project settings -> General -> Web API key.
# Firebase project's Web API key, used only by auth's server-side broker. Not a service-account private key; changing it selects a different Firebase project.
AUTH_FIREBASE_API_KEY=<Web API key>
# Google sign-in: the Web client Firebase made (Google Cloud -> Credentials). Redirect URI: https://auth.callerwhale.com/v1/oauth/google/callback
# Optional direct Google OAuth Web client ID. With Firebase enabled, configured Firebase provider discovery can supply the broker flow instead.
AUTH_GOOGLE_CLIENT_ID=<client id>
# Secret for the optional direct Google OAuth client. Must match its client ID; Firebase-managed broker flow does not require this direct-client override.
AUTH_GOOGLE_CLIENT_SECRET=<client secret>
# Second step (docs/plans/second-factor.md). Email codes are sent by the notification service, which holds the mail login: this
# service only needs its address and its own token there (the "auth" token in the notification service's NOTIFY_TOKENS).
# Telegram: optional, leave empty to not offer it. Authenticator apps and approvals on another device need nothing.
# Notification-service base URL for email codes. Both this URL and AUTH_NOTIFY_TOKEN must be set for email delivery to be offered.
AUTH_NOTIFY_URL=https://notify.callerwhale.com
# Secret caller token matching auth's entry in notifications NOTIFY_TOKENS. Rotate both together; mismatches break authentication emails.
AUTH_NOTIFY_TOKEN=<the auth token from NOTIFY_TOKENS>
# Optional secret BotFather token enabling Telegram code delivery. Leave empty to disable this delivery method; never use a phone number as the token.
AUTH_TELEGRAM_BOT_TOKEN=<BotFather token, or empty>
# Telegram bot's public name used for account linking; must identify the bot whose token auth uses. Optional when Telegram is disabled.
AUTH_TELEGRAM_BOT_NAME=<@bot_name, or empty>
# Secret URL path component protecting the Telegram webhook. Coordinate rotation with Telegram's registered webhook URL.
AUTH_TELEGRAM_WEBHOOK_SECRET=<a long random string, or empty>

# Google reCAPTCHA v3 (invisible, scored) for sign-in and sign-up. This is the only human check auth reads: any AUTH_TURNSTILE_* variable
# left in Coolify from an older setup is ignored and can be deleted.
# Create the key in Google Cloud (reCAPTCHA, Create key): type Web, domains callerwhale.com and auth.callerwhale.com, Challenge, Test key and
# WAF off. Do NOT add tauri.localhost: the desktop app signs in through callerwhale.com in the browser. Then open the key, choose
# "Integrate with a third party service or plugin" to get the legacy secret key. The site key is the key's ID.
# Set the two keys and the hostnames first, then set this to true and redeploy. true needs BOTH keys; missing keys fail startup.
AUTH_BOT_PROTECTION=false
# The key's ID (public; sent to the website). Starts with 6L.
AUTH_RECAPTCHA_SITE_KEY=<key ID, or empty while protection is off>
# The legacy secret key. Held only in auth: Coolify's auth environment, never GitHub, a build variable or chat.
AUTH_RECAPTCHA_SECRET_KEY=<legacy secret key, or empty while protection is off>
# Hostnames a token may come from, comma separated, no scheme or path. Must match the key's domains.
AUTH_RECAPTCHA_HOSTNAMES=callerwhale.com,auth.callerwhale.com
# Lowest Google score (0 bot to 1 human) auth accepts. 0.5 is Google's default; raise it if bots get through, lower it if real people are refused.
AUTH_RECAPTCHA_MIN_SCORE=0.5
