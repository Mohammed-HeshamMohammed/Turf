# The core API (services/core-api/scripts/run-api.sh). Create core-api.env with: node tools/env-init.mjs
DATABASE_URL=postgres://callerwhale_api:callerwhale_api@127.0.0.1:55432/callerwhale
DATABASE_SETUP_URL=postgres://callerwhale_owner:callerwhale_owner@127.0.0.1:55432/callerwhale
REDIS_URL=redis://127.0.0.1:56379
CALLERWHALE_BIND=127.0.0.1:8088
CALLERWHALE_ALLOWED_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
# Secret. Workers present one of these (name=token); env-init generates it and puts the same token in worker.env.
CALLERWHALE_WORKER_TOKENS=dev=__WORKER_TOKEN__
# Secret. The payment provider signs its webhooks with it (24 characters or more; shorter turns webhooks off).
CALLERWHALE_BILLING_WEBHOOK_SECRET=__SECRET__
# Where checkout sends the browser. Empty: no hosted checkout.
CALLERWHALE_CHECKOUT_URL=
# The auth service: the only place people sign in. This server checks the tokens it makes with its public keys, and tells
# the website and the app where it is.
CALLERWHALE_AUTH_JWKS_URL=http://localhost:8101/.well-known/jwks.json
CALLERWHALE_AUTH_PUBLIC_URL=http://localhost:8101
# New accounts may open their own trial (false: by invitation only).
CALLERWHALE_PUBLIC_SIGNUP=false
CALLERWHALE_REQUIRE_MFA=false
# The Grafana login proxy (services/grafana-proxy), where the admin dashboard sends staff. Empty: no Grafana.
CALLERWHALE_GRAFANA_URL=
# Caller Whale's staff confirm an authenticator code to open the admin pages. false only while no staff member has
# an authenticator set up yet.
CALLERWHALE_STAFF_MFA=true
# Desktop access by invitation (docs/plans/callerwhale-launch.md). The website people are invited to.
CALLERWHALE_WEBSITE_URL=http://localhost:5200
# Invitations are emailed by the notification service (this server has no mail login). Its address and this server's token there
# (the core-api name=token pair in its NOTIFY_TOKENS). Either empty: invitations are saved, not emailed.
CALLERWHALE_NOTIFY_URL=
# Secret.
CALLERWHALE_NOTIFY_TOKEN=
# The GitHub repository whose releases hold the desktop installer, offered to invited people only. Empty: no download.
CALLERWHALE_RELEASE_REPO=Mohammed-HeshamMohammed/Turf
CALLERWHALE_RELEASE_TAG_PREFIX=crm-v
# Secret, optional. A token that can read the releases, for a private repository.
CALLERWHALE_GITHUB_TOKEN=
