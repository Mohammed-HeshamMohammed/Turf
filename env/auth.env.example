# The auth service (services/auth/scripts/run-auth.sh).
DATABASE_URL=sqlite://auth.db?mode=rwc
PORT=8101
# Secret. Signs every access token; env-init generates one. Changing it signs everyone out.
AUTH_SIGNING_KEY=__SIGNING_KEY__
AUTH_PUBLIC_URL=http://localhost:8101
AUTH_WEBSITE_URL=http://localhost:8088
AUTH_APP_URL=http://localhost:5190
# Where a sign-in started from the public site (callerwhale.com) returns.
AUTH_LANDING_URL=http://localhost:5200
AUTH_PUBLIC_SIGNUP=true
# Development only: return confirmation tokens in responses, since emails are not sent yet.
AUTH_DEV_TOKENS=true
# Google sign-in: a Web OAuth client whose redirect URI is <AUTH_PUBLIC_URL>/v1/oauth/google/callback. The secret is secret.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Apple sign-in. The private key is secret (the .p8 file's text on one line, with \n for its line breaks).
AUTH_APPLE_CLIENT_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=
# Firebase Authentication as the account store (docs/plans/firebase-auth.md). This service is the only part that talks to
# it: passwords, email links, authenticator codes and Google go through Firebase's server API, and everyone else gets this
# service's own tokens. Empty: this service keeps its own accounts. The key is the project's Web API key (Firebase console,
# Project settings, General); it is not a secret, but it belongs only here.
AUTH_FIREBASE_API_KEY=
# The second step at sign-in (docs/plans/second-factor.md). Authenticator apps need nothing here. Email codes need a mail server;
# Telegram codes need a bot (BotFather). Each is offered only when set.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
# Secret. The mailbox's password.
AUTH_SMTP_PASSWORD=
AUTH_MAIL_FROM=Caller Whale <no-reply@softfix.dev>
# Secret. The bot's token from BotFather; AUTH_TELEGRAM_BOT_NAME is its @name. The webhook's address is
# https://<AUTH_PUBLIC_URL host>/v1/mfa/telegram/webhook/<AUTH_TELEGRAM_WEBHOOK_SECRET> (set it once with Telegram's setWebhook).
AUTH_TELEGRAM_BOT_TOKEN=
AUTH_TELEGRAM_BOT_NAME=
AUTH_TELEGRAM_WEBHOOK_SECRET=
