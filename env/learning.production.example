# The learning store on Coolify (application "learning", branch learning-backend-production, port 8112, network alias learning, NO domain).
# It has its OWN PostgreSQL resource (learning-postgres): never the CRM's database, never the auth database. Keep a copy of LEARNING_HASH_KEY
# somewhere safe, away from Coolify: without it the stored hashes cannot be matched again.
# Paste into Environment Variables -> Developer View. Secrets stay in Coolify; never commit a filled copy.
# HTTP port; default 8112. Match Coolify's container port.
PORT=8112
# This service's own database (the learning-postgres resource's internal URL, database "learning", its own login). Never the CRM's or the auth database.
DATABASE_URL=postgres://learning:<password>@<learning-postgres host>:5432/learning?sslmode=disable
# The token crm-core sends (at least 32 characters). The same value is crm-core's LEARNING_TOKEN.
LEARNING_TOKEN=<a long random token>
# The key the phone and email hashes are made with: 64 hex characters (32 bytes). Held only by the platform owners; losing it makes the stored hashes unusable, and changing it breaks matching of old rows with new ones.
LEARNING_HASH_KEY=<64 hex characters>
# true lets lists in and flags be recorded. Leave it false (nothing is taken in) until the terms and privacy notice say what is kept.
LEARNING_ENABLED=false
# Days a learned row is kept before it is deleted; default 730 (two years).
LEARNING_RETENTION_DAYS=730
