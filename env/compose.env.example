# Every service on one machine (deploy/compose/compose.yml): docker compose --env-file env/compose.env -f deploy/compose/compose.yml up
# Secret. The database's password; env-init generates it.
POSTGRES_PASSWORD=__SECRET__
# Secret. Signs every access token; env-init generates one.
AUTH_SIGNING_KEY=__SIGNING_KEY__
# Secret. Signs the authorization service's grants; env-init generates one.
AUTHZ_SIGNING_KEY=__SIGNING_KEY__
# Secret. Billing's token at the authorization service (AUTHZ_TOKENS there, AUTHZ_TOKEN in billing).
AUTHZ_BILLING_TOKEN=__SECRET__
# Secret. Auth's read-only token at the authorization service (AUTHZ_TOKENS there, AUTHZ_TOKEN in auth).
AUTHZ_AUTH_TOKEN=__SECRET__
# Secret. crm-core's token at the authorization service (the core-api entry in AUTHZ_TOKENS there, AUTHZ_TOKEN in crm-core).
AUTHZ_CORE_TOKEN=__SECRET__
