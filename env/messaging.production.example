# The messaging service on Coolify (application "messaging", branch messaging-backend-production, port 8108, network alias messaging, NO domain of its own).
# It keeps team chats and groups; the gateway routes chat.callerwhale.com to it. Setup: docs/plans/coolify-setup-messaging.md.
# Paste into Environment Variables -> Developer View. Fill every <...>. Secrets stay in Coolify; never commit a filled copy.
# HTTP port; default 8108. Match Coolify's container port and the gateway's ROUTES.
PORT=8108
# Secret PostgreSQL URI of the messaging database (Caller Whale Messaging PostgreSQL). The service makes its own tables (schema messaging) and runs each request as a restricted role.
DATABASE_URL=<postgres://postgres:password@<messaging database internal host>:5432/postgres?sslmode=require>
# The auth service's public keys at its private address; sign-in tokens are checked with them locally.
AUTH_JWKS_URL=http://auth:8101/.well-known/jwks.json
# The authorization service's private address.
AUTHZ_URL=http://authz:8104
# Secret: the value after messaging= in authz's AUTHZ_TOKENS, 32+ characters.
AUTHZ_TOKEN=<the messaging token from authz's AUTHZ_TOKENS>
# Pages that may call this service from a browser. Keep it the same as the gateway's CORS_ORIGINS.
CORS_ORIGINS=https://app.callerwhale.com
# Secret: the same value as Centrifugo's CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY, 32+ characters.
LIVE_TOKEN_SECRET=<the live server's token secret>
# Where the apps open their socket: the live server's public address through the gateway.
LIVE_PUBLIC_URL=wss://live.callerwhale.com/connection/websocket
# Secret: 64 random hex characters. The password of messaging_live, the login (outbox rows only) the live server reads with; also in its CENTRIFUGO_CONSUMERS_MESSAGING_POSTGRESQL_DSN.
LIVE_DB_PASSWORD=<64 random hex characters>
# Switch-over only: the live server's (Centrifugo's) private API address. Set, this service also sends live updates itself (the old way). Remove it, with LIVE_API_KEY, once the live server reads the outbox.
LIVE_API_URL=http://centrifugo:8000/api
# Switch-over only, secret: the same value as Centrifugo's CENTRIFUGO_HTTP_API_KEY, 32+ characters. Remove it with LIVE_API_URL.
LIVE_API_KEY=<the live server's API key>
