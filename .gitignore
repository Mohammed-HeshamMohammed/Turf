# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Tauri
**/src-tauri/target
**/src-tauri/gen/schemas

# Python
__pycache__/
*.pyc
.pytest_cache/

# The packaged engine (engines/skip-engine/tools/build_service.py)
engines/skip-engine/build
engines/skip-engine/dist

# Rust build output and local dev accounts
target/
**/scripts/.dev-accounts.json

# Generated local image helpers; production snapshots inject the canonical source.
scaffolds/*/runtime-log/main.go

# Local settings and secrets, wherever they are (these rules were in Caller Whale CRM/.gitignore before the apps moved out, step 52, D386)
.env*
!.env.example
.vercel/
.vite/
apps/crm-desktop/gen/

# Built programs never go into the repository (a messaging.exe was committed once, removed in step 50+51)
*.exe

# Runtime settings stay ignored; only examples, the README and the two named documentation JSON files are committed (D386: these
# rules moved here from Caller Whale CRM/.gitignore in the same commit as env/ itself, step 54).
env/*
!env/README.md
# Non-secret documentation catalog and variable-name inventory; never include runtime values.
!env/container-notes.json
!env/container-variable-inventory.json
!env/*.example
