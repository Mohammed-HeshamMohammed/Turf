# The build context is the repository root (step 50+51): send only this service and the shared Go modules.
*
!packages/go
!services/auth
**/node_modules
**/__pycache__
**/.env
**/.env.*
**/*.exe
services/auth/*_test.go
services/auth/clients
services/auth/scripts
services/auth/openapi.yaml
services/auth/README.md
