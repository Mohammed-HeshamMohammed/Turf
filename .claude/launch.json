{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "turf",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Turf",
        "run",
        "dev"
      ],
      "port": 5183
    },
    {
