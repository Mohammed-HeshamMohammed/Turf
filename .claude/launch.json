{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "callerwhale",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Caller Whale App",
        "run",
        "dev"
      ],
      "port": 5183
    },
    {
      "name": "full-crm-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Caller Whale CRM/desktop/frontend/react",
        "run",
        "dev",
        "--",
        "--port",
        "5190",
        "--strictPort"
      ],
      "port": 5190
    },
    {
      "name": "callerwhale-auth",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": [
        "Caller Whale CRM/services/auth/scripts/run-auth.sh"
      ],
      "port": 8101
    },
    {
      "name": "callerwhale-api",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": [
        "Caller Whale CRM/services/core-api/scripts/run-api.sh"
      ],
      "port": 8088
    },
    {
      "name": "callerwhale-worker",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": [
        "Caller Whale CRM/services/core-api/scripts/run-worker.sh"
      ],
      "port": 8090
    },
    {
      "name": "landing-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Caller Whale CRM/landing/api",
        "start"
      ],
      "port": 8095
    },
    {
      "name": "landing-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "Caller Whale CRM/landing/web",
        "run",
        "dev"
      ],
      "port": 5200
    }
  ]
}
