# Database setup checksums and shell scripts need exact LF content on every checkout.
**/database_setup/*.sql text eol=lf
*.sh text eol=lf

# Preserve the bytes of every binary file; text normalization corrupts them (24 JPEGs lost bytes to it in October 2026).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.xlsx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.ico binary
*.icns binary
